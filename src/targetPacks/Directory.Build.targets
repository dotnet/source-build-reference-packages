<Project>

  <Import Project="..\..\Directory.Build.targets" />
  <Import Project="$(RepositoryEngineeringDir)ILTooling.targets" />

  <PropertyGroup>
    <!-- Where the ilasm output lands. The DLLs are then surfaced as <None Pack="true">
         items via _AddTargetingPackDllsToPack so MSBuild Pack picks them up at the
         correct relative package path. -->
    <_TargetingPackIlOutputDir>$(IntermediateOutputPath)pack-content\</_TargetingPackIlOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <_TargetingPackIlSrc Include="$(MSBuildProjectDirectory)\**\*.il" />
  </ItemGroup>
  <ItemGroup>
    <_TargetingPackIlSrc Update="@(_TargetingPackIlSrc)" OutputFile="$(_TargetingPackIlOutputDir)%(RecursiveDir)%(Filename).dll" />
  </ItemGroup>

  <Target Name="BuildTargetingPackIlSrc"
          BeforeTargets="GenerateNuspec"
          Inputs="@(_TargetingPackIlSrc)"
          Outputs="@(_TargetingPackIlSrc->'%(OutputFile)')"
          DependsOnTargets="ResolveIlToolPaths"
          Condition="'@(_TargetingPackIlSrc)' != ''">
    <Message Importance="High" Text="[$([System.DateTime]::Now.ToString('HH:mm:ss.ff'))] Begin $(MSBuildProjectName) -> $(_TargetingPackIlOutputDir)..." />
    <MakeDir Directories="@(_TargetingPackIlSrc->'$(_TargetingPackIlOutputDir)%(RecursiveDir)')" />

    <ItemGroup>
      <_IndividualFileProject Include="$(MSBuildProjectFullPath)"
                              Properties="IlFile=%(_TargetingPackIlSrc.Identity);OutputFile=%(_TargetingPackIlSrc.OutputFile)" />
    </ItemGroup>

    <MSBuild Projects="@(_IndividualFileProject)"
             Targets="BuildIlFile"
             BuildInParallel="true"
             StopOnFirstFailure="true" />

    <Message Importance="High" Text="[$([System.DateTime]::Now.ToString('HH:mm:ss.ff'))] $(MSBuildProjectName) -> $(_TargetingPackIlOutputDir) DONE" />
  </Target>

  <Target Name="BuildIlFile" DependsOnTargets="ResolveIlToolPaths">
    <Error Condition="'$(IlasmPath)' == ''" Text="The 'IlasmPath' property must be set." />

    <Exec Command="$(IlasmPath) $(IlFile) -dll -quiet -nologo &quot;-output=$(OutputFile)&quot;"
          IgnoreStandardErrorWarningFormat="true"
          CustomErrorRegularExpression=": error : " />
  </Target>

  <!-- Surface the assembled DLLs as <None Pack="true"> items at the same relative path
       inside the package as their .il counterpart sits on disk (e.g. ref/net6.0/X.il
       becomes ref/net6.0/X.dll in the package). -->
  <Target Name="_AddTargetingPackDllsToPack"
          BeforeTargets="_GetPackageFiles"
          DependsOnTargets="BuildTargetingPackIlSrc"
          Condition="'@(_TargetingPackIlSrc)' != ''">
    <ItemGroup>
      <None Include="@(_TargetingPackIlSrc->'%(OutputFile)')"
            Pack="true"
            PackagePath="%(_TargetingPackIlSrc.RecursiveDir)" />
    </ItemGroup>
  </Target>

  <!-- Stage the targeting pack content into $(BaseOutputPath)pack/ in its final package
       layout. This is what `UseLocalTargetingPack` in src/referencePackages/Directory.Build.targets
       reads via `<ResolvedTargetingPack Path="$(ArtifactsBinDir)<id>.<ver>/pack" />` so that
       reference packages compile against the freshly-built local target packs instead of any
       SDK-bundled ones. The historical eng/ManualNuspec.targets file populated the same
       location; we replicate it here without going through a hand-authored nuspec. -->
  <PropertyGroup>
    <_TargetingPackLayoutDir>$(BaseOutputPath)pack\</_TargetingPackLayoutDir>
  </PropertyGroup>

  <Target Name="_StageTargetingPackLayout"
          AfterTargets="Pack"
          DependsOnTargets="BuildTargetingPackIlSrc"
          Condition="'@(_TargetingPackIlSrc)' != ''">
    <ItemGroup>
      <!-- Static on-disk content (LICENSE.TXT, build/<tfm>/*.targets, data/*.xml, etc.). -->
      <_TargetingPackStaticContent Include="$(MSBuildProjectDirectory)\**\*.*"
                                   Exclude="$(MSBuildProjectDirectory)\**\*.il;
                                            $(MSBuildProjectDirectory)\**\*.csproj;
                                            $(MSBuildProjectDirectory)\**\$(CustomizationsPropsFile);
                                            $(MSBuildProjectDirectory)\**\$(CustomizationsSourceFile)" />
      <!-- Assembled DLLs from ilasm. Their on-disk RecursiveDir already mirrors the package
           layout (e.g. ref/net6.0/, build/net461/lib/). -->
      <_TargetingPackAssembledDll Include="$(_TargetingPackIlOutputDir)**\*.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(_TargetingPackStaticContent)"
          DestinationFiles="@(_TargetingPackStaticContent->'$(_TargetingPackLayoutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(_TargetingPackAssembledDll)"
          DestinationFiles="@(_TargetingPackAssembledDll->'$(_TargetingPackLayoutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Targeting packs don't have buildable source. Override the SDK Build target to a no-op
       so Pack doesn't try to compile (and fail resolving netstandard2.0 references that
       this project doesn't actually need). The IL→DLL assembly happens in
       BuildTargetingPackIlSrc, hooked into BeforeTargets="GenerateNuspec". -->
  <Target Name="Build" />

</Project>
