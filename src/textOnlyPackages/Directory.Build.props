<Project>
  <Import Project="..\..\Directory.Build.props" />

  <PropertyGroup>
    <IsTextOnlyPackage>true</IsTextOnlyPackage>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>

    <!-- Disable NU5128: text-only packages declare TFMs that have no lib/ref content
         (workload manifests, source-only packages, etc.). NuGet flags this even though
         it's the intentional layout. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!-- Disable NU5048: continue to use deprecated 'PackageIconUrl'/'iconUrl' for now
         (Microsoft.NETCore.Platforms text packages). -->
    <NoWarn>$(NoWarn);NU5048</NoWarn>
  </PropertyGroup>

</Project>
