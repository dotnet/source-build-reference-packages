<Project>

  <!-- Target frameworks that source-build doesn't support/include.
       This list is consumed by both the package source generator (for filtering which TFMs to
       generate) and package validation (for ignoring baseline comparisons against absent TFMs).
       Keep the two uses in sync by defining the canonical list here. -->
  <PropertyGroup>
    <ExcludeTargetFrameworks>monoandroid*;monotouch*;net20;net35;net4*;net5.0;netcore50;netcoreapp*;netstandard1*;portable*;uap*;win8;win81;wp8;wpa81;xamarin*</ExcludeTargetFrameworks>

    <!-- Same list with '*' escaped as '%2A' for use in MSBuild ItemGroup Include attributes where
         wildcards would otherwise be treated as file globs. -->
    <ExcludeTargetFrameworksMSBuildEscaped>monoandroid%2A;monotouch%2A;net20;net35;net4%2A;net5.0;netcore50;netcoreapp%2A;netstandard1%2A;portable%2A;uap%2A;win8;win81;wp8;wpa81;xamarin%2A</ExcludeTargetFrameworksMSBuildEscaped>
  </PropertyGroup>

</Project>
